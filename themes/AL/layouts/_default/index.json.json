{{- /*
  Search index. One entry per searchable page.
  Keys are short to keep the file small:
    t = title, u = URL, s = parent section title, c = plain text content
*/ -}}
{{- $index := slice -}}
{{- range site.Pages -}}
  {{- if and (in (slice "page" "section") .Kind) (ne .Type "search") .RelPermalink -}}
    {{- $content := .Plain | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace -}}
    {{- $section := "" -}}
    {{- with .Parent -}}
      {{- if not .IsHome -}}
        {{- $section = .Title -}}
      {{- end -}}
    {{- end -}}
    {{- $index = $index | append (dict
        "t" (.Title | default .LinkTitle | htmlUnescape)
        "u" .RelPermalink
        "s" $section
        "c" $content
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}